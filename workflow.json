    {
      "parameters": {
        "jsCode": "const tasks = $input.all();\nif (tasks.length === 0 || !tasks[0].json.Task) {\n  return [{ json: { reply: \"📋 You have no pending tasks right now!\" } }];\n}\nconst taskList = tasks\n  .filter(t => t.json.Task)\n  .map(t => `• ${t.json.Task}`)\n  .join('\\n');\nreturn [{ json: { reply: `📋 Your pending tasks:\\n${taskList}` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
